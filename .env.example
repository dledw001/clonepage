# DSM connection settings. DSM passwords and sessions are never stored here.
CLONEPAGE_ORIGIN=https://clonepage.dledwith.com
DSM_URL=https://dsm.dledwith.com
# LAN address for service HTTPS checks. Empty uses normal DNS instead.
DSM_PROXY_IP=10.0.0.149
DSM_SERVICE_DOMAIN=dledwith.com
DSM_UPSTREAM_HOSTS=10.0.0.149,127.0.0.1,localhost

# WUD container-update monitoring. Use a personal token from a read-only account.
WUD_URL=http://10.0.0.149:3000
WUD_API_TOKEN=
# Optional address for the Open WUD link; defaults to WUD_URL.
WUD_PUBLIC_URL=
